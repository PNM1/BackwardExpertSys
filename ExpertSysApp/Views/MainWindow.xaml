<Window x:Class="ExpertSysApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExpertSysApp"
        mc:Ignorable="d"
        Title="Помощник по ремонту автомобилей" Height="450" Width="580" MinHeight="310" MinWidth="460"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBarPanel Grid.Row="0" Orientation="Horizontal" Margin="10, 0">
            <Button Content="Открыть файл" Click="OpenFile_Click" Margin="0,0,5,0" Width="100" HorizontalAlignment="Left"/>
            <Button Content="Сохранить базу правил" Click="SaveFileAs_Click" Margin="0,0,5,0" Width="150" HorizontalAlignment="Left"/>
            <Button Content="Редактор базы правил" Click="OpenEditor_Click" Width="150" HorizontalAlignment="Left"/>
        </ToolBarPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" x:Name="TraceColumnDef"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Стартовая ситуация:" FontWeight="Bold"/>
                <TextBox Grid.Row="1" x:Name="TxtInputFacts" Margin="0,5,0,10" TextWrapping="Wrap" AcceptsReturn="True"/>

                <CheckBox Grid.Row="2" x:Name="ChkTrace" Content="Показать сведения о поиске" Checked="ChkTrace_Checked" Unchecked="ChkTrace_Unchecked" Margin="0,0,0,10"/>

                <Button Grid.Row="3" Content="Найти ответ" Click="Search_Click" Height="35" Background="LightGreen"/>

                <TextBlock Grid.Row="4" Text="Результат:" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBox Grid.Row="5" x:Name="TxtResult" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
            </Grid>

            <Border Grid.Column="1" Margin="5,0,0,0" x:Name="TracePanel" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Трассировка поиска:" FontWeight="Bold"/>
                    <ListBox Grid.Row="1" x:Name="LbTrace" Margin="0,5,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RuleDescription}" Background="{Binding StatusColor}" Padding="3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
