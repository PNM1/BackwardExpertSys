<Window x:Class="ExpertSysApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExpertSysApp"
        mc:Ignorable="d"
        Title="Помощник по ремонту автомобилей" Height="450" Width="580"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBarPanel Grid.Row="0" Orientation="Horizontal" Margin="10, 0">
            <Button Content="Открыть файл" Click="OpenFile_Click" Margin="0,0,5,0" Width="100" HorizontalAlignment="Left"/>
            <Button Content="Сохранить базу правил" Click="SaveFileAs_Click" Margin="0,0,5,0" Width="150" HorizontalAlignment="Left"/>
            <Button Content="Редактор базы правил" Click="OpenEditor_Click" Width="150" HorizontalAlignment="Left"/>
        </ToolBarPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" x:Name="TraceColumnDef"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Исходные данные:"/>
                <TextBox x:Name="TxtInputFacts" MinHeight="50" Margin="0,5,0,10"/>

                <CheckBox x:Name="ChkTrace" Content="Показать трассировку поиска" Checked="ChkTrace_Checked" Unchecked="ChkTrace_Unchecked" Margin="0,0,0,10"/>

                <Button Content="Найти ответ" Click="Search_Click" Height="35" Background="LightGreen"/>

                <TextBlock Text="Результат:" FontWeight="Bold" Margin="0,35,0,5"/>
                <TextBox x:Name="TxtResult" IsReadOnly="True" Height="170"/>
            </StackPanel>

            <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="Gray" BorderThickness="1" Padding="5" x:Name="TracePanel" Visibility="Collapsed" Width="350">
                <StackPanel>
                    <TextBlock Text="Трассировка поиска:" FontWeight="Bold"/>
                    <ListBox x:Name="LbTrace" Height="335" Margin="0,5,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RuleDescription}" Background="{Binding StatusColor}" Padding="3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
